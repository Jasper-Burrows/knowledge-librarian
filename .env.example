# Offline mode is fully functional without credentials.
LIBRARIAN_MODE=offline
LIBRARIAN_DATABASE_PATH=./data/librarian.db
LIBRARIAN_FRONTEND_DIST=./frontend/dist
LIBRARIAN_ALLOWED_ORIGINS=http://localhost:5173
LIBRARIAN_MAX_UPLOAD_BYTES=10485760
# Required only when triggering source sync from a non-loopback client.
LIBRARIAN_SYNC_TOKEN=

# Live OpenAI mode (use a newly issued personal key; never reuse internship keys).
OPENAI_API_KEY=
LIBRARIAN_OPENAI_MODEL=gpt-5.6-terra
LIBRARIAN_EMBEDDING_MODEL=text-embedding-3-small

# Live validation is blocked unless all three values are intentionally supplied.
LIBRARIAN_LIVE_VALIDATION_BUDGET_USD=10.00
LIBRARIAN_LIVE_VALIDATION_APPROVAL=
LIBRARIAN_LIVE_VALIDATION_KEY_ROTATED=false

# Optional provider integrations. Enable each source explicitly.
LIBRARIAN_CLICKUP_ENABLED=false
CLICKUP_API_TOKEN=
CLICKUP_TEAM_ID=
LIBRARIAN_HUBSPOT_ENABLED=false
HUBSPOT_ACCESS_TOKEN=
LIBRARIAN_STONLY_ENABLED=false
STONLY_BASE_URL=
STONLY_API_TOKEN=
LIBRARIAN_MS_GRAPH_ENABLED=false
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_MAILBOX=
LIBRARIAN_PINECONE_ENABLED=false
PINECONE_API_KEY=
PINECONE_INDEX_NAME=
LIBRARIAN_SLACK_ENABLED=false
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_SIGNING_SECRET=
